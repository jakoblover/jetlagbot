@page
@model IndexModel
@{
    ViewData["Title"] = "Hjem";
}

<div class="text-center">
    <h1 class="display-4">JetlagBot</h1>
    <p class="lead">Discord-bot for anbefalinger og personlige bonusvarsler.</p>

    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a class="btn btn-primary" asp-page="/Bonus/Index">Bonusvarsler</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-outline-secondary" asp-page="/Admin/Index">Administrasjon</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-page="/Account/Login">Logg inn med Discord</a>
        }
    </div>
</div>
